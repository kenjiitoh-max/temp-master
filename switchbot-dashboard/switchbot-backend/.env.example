# SwitchBot API 認証情報（取得手順）
# 1. SwitchBot アプリで プロフィール > 設定 > アプリバージョン を10回タップして開発者オプションを有効化
# 2. 開発者オプション > トークンを取得
SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# /api/backup 用の共有シークレット（必須ではないが、未設定だとバックアップ機能は無効化され 404 を返す）
# 生成例: openssl rand -hex 32
# 本番(Fly.io)では .env ではなく `fly secrets set BACKUP_TOKEN=...` で設定する
BACKUP_TOKEN=

# SQLite ファイルのパス（省略時: /data があれば /data/app.db、なければカレントの app.db）
# DB_PATH=./app.db
