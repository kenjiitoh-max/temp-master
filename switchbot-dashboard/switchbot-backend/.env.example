# SwitchBot API Credentials
# Get these from the SwitchBot app:
# 1. Go to Profile > Preferences > About
# 2. Tap App Version 10 times to enable Developer Options
# 3. Go to Developer Options > Get Token

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# API token protecting state-changing / data-export endpoints
# (/api/backup, /api/import, /api/meters/refresh).
# Generate a strong random value, e.g. `openssl rand -hex 32`.
# If left empty, those endpoints are DISABLED (return HTTP 503) so they are
# never exposed without authentication.
API_TOKEN=

# Comma-separated list of origins allowed by CORS.
# Defaults to the production frontend origin when unset.
# Example for local development:
# ALLOWED_ORIGINS=http://localhost:5173,https://temp-master.fly.dev
ALLOWED_ORIGINS=https://temp-master.fly.dev
