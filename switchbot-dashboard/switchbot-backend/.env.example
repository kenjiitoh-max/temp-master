# SwitchBot API Credentials
# Get these from the SwitchBot app:
# 1. Go to Profile > Preferences > About
# 2. Tap App Version 10 times to enable Developer Options
# 3. Go to Developer Options > Get Token

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# ダッシュボードAPIキー認証
# 機密・変更系エンドポイント（/api/backup, /api/import, /api/meters/refresh）は
# X-API-Key ヘッダでこのキーによる認証を要求する。
# 未設定の場合、これらのエンドポイントは 503 を返し、無認証では開放されない（安全側）。
# 十分に長いランダム文字列を設定すること（例: `openssl rand -hex 32`）。
DASHBOARD_API_KEY=your_dashboard_api_key_here

# CORS 許可オリジン（カンマ区切り）
# 例: ALLOWED_ORIGINS=https://example.com,https://dashboard.example.com
# 未設定時は空リスト（同一オリジン運用を想定）。
# "*"（ワイルドカード）を含む場合、資格情報付きリクエスト（allow_credentials）は
# 自動的に無効化される（ワイルドカード + credentials の危険な併用を避けるため）。
ALLOWED_ORIGINS=
