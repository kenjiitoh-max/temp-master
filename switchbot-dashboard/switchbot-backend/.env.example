# SwitchBot API Credentials
# Get these from the SwitchBot app:
# 1. Go to Profile > Preferences > About
# 2. Tap App Version 10 times to enable Developer Options
# 3. Go to Developer Options > Get Token

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# Shared secret for protected endpoints (/api/import, /api/backup, /api/meters/refresh).
# Clients send it in the X-API-Key header. Generate one with: openssl rand -hex 32
# Left empty, the protected endpoints refuse every request (503) instead of accepting a known key.
API_KEY=

# Comma-separated origins allowed to call the API cross-origin (leave empty when the
# frontend is served by this backend, e.g. ALLOWED_ORIGINS=https://temp-master.fly.dev)
ALLOWED_ORIGINS=
